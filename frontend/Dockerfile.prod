# build env
FROM node:20.20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
# preferred, but there appears to be some overlap 
# RUN npm ci --omit=dev
COPY . ./
# preferred, but there appears to be issues
# COPY ./src ./src
# COPY ./public ./public
# COPY ./tsconfig.json ./tsconfig.json
# COPY ./.prettierrc.json ./.prettierrc.json
# COPY ./.eslintrc.js ./.eslintrc.js

# Disable ESLint during production build - linting happens in CI, not deployment
ENV DISABLE_ESLINT_PLUGIN=true
RUN npm run build

# production env
FROM nginx:1.15-alpine
USER root
COPY --from=build /app/build /usr/share/nginx/html
COPY --from=build /app/nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Inyectar timestamp de build en index.html para forzar actualizaciones
RUN set -eux; \
    sed -i "s|%BUILD_TIMESTAMP%|$(date +%s)|g" /usr/share/nginx/html/index.html; \
    css_file="$(find /usr/share/nginx/html/static/css -maxdepth 1 -type f -name 'main.*.css' ! -name '*.map' | head -n1)"; \
    css_map_file="$(find /usr/share/nginx/html/static/css -maxdepth 1 -type f -name 'main.*.css.map' | head -n1)"; \
    js_file="$(find /usr/share/nginx/html/static/js -maxdepth 1 -type f -name 'main.*.js' ! -name '*.map' | head -n1)"; \
    js_map_file="$(find /usr/share/nginx/html/static/js -maxdepth 1 -type f -name 'main.*.js.map' | head -n1)"; \
    [ -n "$css_file" ]; \
    [ -n "$js_file" ]; \
    cp "$css_file" /usr/share/nginx/html/static/css/main.css; \
    cp "$js_file" /usr/share/nginx/html/static/js/main.js; \
    if [ -n "$css_map_file" ]; then cp "$css_map_file" /usr/share/nginx/html/static/css/main.css.map; fi; \
    if [ -n "$js_map_file" ]; then cp "$js_map_file" /usr/share/nginx/html/static/js/main.js.map; fi

RUN apk update; \
    apk upgrade; \
    apk add curl; \
    apk add bash

ADD nginx/healthcheck.sh /healthcheck.sh
RUN chown nginx:nginx /healthcheck.sh; \
    chmod 770 /healthcheck.sh;

CMD ["nginx", "-g", "daemon off;"]
